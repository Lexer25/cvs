# Игнорировать все файлы с расширением bak
*.bak

# Игнорировать каталог log в любом месте репозитория
**/logs

# Игнорировать содержимое папок cache, но сохранять .gitkeep
**/cache/*
!application/cache/.gitkeep

# Игнорировать содержимое папок log, но сохранять .gitkeep
**/logs/*
!application/logs/.gitkeep

